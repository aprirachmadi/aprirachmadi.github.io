  "architecture": {
    "facts": [
      "MCP gathers ticket/company context and retrieves historical resolutions.",
      "Separate model calls classify a ticket and draft a reply.",
      "Preview performs no ticket updates; Apply generates again and writes labels, an assessment and an unsent draft.",
      "Technician approval checks the saved revision and never sends."
    ],
